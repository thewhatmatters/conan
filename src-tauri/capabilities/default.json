{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "shell:default",
    "notification:default",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        { "name": "binaries/conan-gateway", "sidecar": true, "args": true }
      ]
    },
    "process:default",
    "updater:default"
  ]
}
