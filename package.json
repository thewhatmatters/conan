{
  "name": "conan",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "description": "Conan — an always-on web UI/control layer that observes and drives Claude Code.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/gateway/index.ts",
    "start": "tsx src/gateway/index.ts",
    "postinstall": "node scripts/fix-node-pty.mjs",
    "typecheck": "tsc --noEmit",
    "hooks:install-global": "tsx scripts/install-global-hooks.mjs",
    "build:ui": "npm --prefix ui run build",
    "build": "npm run typecheck && npm run build:ui",
    "build:sidecar": "node scripts/build-sidecar.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "better-sqlite3": "^11.8.1",
    "express": "^4.21.2",
    "node-pty": "^1.1.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@noble/ed25519": "^3.1.0",
    "@noble/hashes": "^2.2.0",
    "@tauri-apps/cli": "^2.11.2",
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "@types/ws": "^8.5.13",
    "esbuild": "^0.28.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
